server:
  port: 8082

spring:
  application:
    name: user-service
  datasource:
    url: ${ORACLE_URL:jdbc:oracle:thin:@localhost:1521:xe}
    driver-class-name: oracle.jdbc.OracleDriver
    username: ${ORACLE_USER:user_db}
    password: ${ORACLE_PASSWORD:userpassword}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

eureka:
  client:
    serviceUrl:
      defaultZone: http://localhost:8761/eureka/
